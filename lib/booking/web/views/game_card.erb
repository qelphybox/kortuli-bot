<%#
  A Game as the group sees it — the page behind the link in the message, open
  without a session, because the people it was sent to need not use the bot.
  A ticket: when, where, and whether it will rain on it; then the way there
  and the two calendar buttons. Plain links throughout: this is a browser
  tab, not the mini app.
%>
<% starts = Booking::Clock.to_local(@game.starts_at) %>
<main class="invite">
  <div class="invite__top">
    <span class="brand"><%= ball(size: 22) %><span class="brand__word">KORTULI</span></span>
    <span class="invite__aside">You're invited</span>
  </div>

  <article class="ticket">
    <%= court(:ticket, "ticket__court") %>
    <div class="ticket__main">
      <span class="ticket__tag">Padel · court booked</span>
      <% from, to = Booking::Messages.local_clock(@game.starts_at), Booking::Messages.local_clock(@game.ends_at) %>
      <div class="ticket__time"><span class="visually-hidden"><%= from %>–<%= to %></span><span aria-hidden="true"><%= from %><span>–</span><%= to %></span></div>
      <div class="ticket__day"><%= Booking::Messages::DAY_NAMES[starts.wday] %> <%= starts.day %> <%= starts.strftime("%b") %></div>
      <div class="ticket__club"><%= h(@game.club_name) %></div>
    </div>
    <div class="ticket__tear" aria-hidden="true"><span></span></div>
    <%= erb :_game_facts, locals: { game: @game, weather: @weather } %>
  </article>

  <div class="section">
    <% if @game.maps_url %>
      <a class="btn btn--ball" href="<%= h(@game.maps_url) %>" target="_blank" rel="noopener"><%= icon(:pin) %>Directions</a>
    <% end %>
    <div class="btn-row">
      <a class="btn btn--quiet" href="<%= h(Booking::Calendar.google_url(@event)) %>" target="_blank" rel="noopener"><%= icon(:calendar, size: 16) %>Google Calendar</a>
      <a class="btn btn--quiet" href="<%= h(@game.card_url) %>.ics"><%= icon(:calendar, size: 16) %>Apple &amp; other</a>
    </div>
  </div>

  <a class="invite__foot" href="<%= h(bot_url) %>">Found free courts with <span>@<%= h(settings.bot_username) %></span></a>
</main>
