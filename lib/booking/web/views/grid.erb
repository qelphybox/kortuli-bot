<%#
  One row per Club, one column per hour, one page per date. Clubs keep
  different hours, so the columns are the union of all of them and a row
  simply has no cell where its club is shut.
%>
<%= erb :tabs, layout: false, locals: { here: :grid } %>

<nav class="days">
  <% @dates.each do |d| %>
    <a class="day<%= " is-on" if d == @date %>" href="/?date=<%= d %>"><%= day_label(d) %></a>
  <% end %>
</nav>

<div class="grid-scroll">
  <table class="grid">
    <thead>
      <tr>
        <th class="club"><span class="visually-hidden">Club</span></th>
        <% @table.columns.each do |at| %>
          <th scope="col"><%= hour_label(at) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @table.rows.each do |row| %>
        <tr>
          <th scope="row" class="club"><%= row.club_name %></th>
          <% @table.columns.each do |at| %>
            <% cell = row.cell_at(at) %>
            <% if cell.nil? %>
              <td class="shut" aria-label="closed"></td>
            <% elsif cell.free? %>
              <%# data-external is what makes the client hand this to Telegram
                  rather than opening a booking site inside the mini app. %>
              <td class="free">
                <a data-external href="<%= cell.deeplink %>"
                   aria-label="<%= row.club_name %> at <%= hour_label(at) %>:00, free">
                  <%= cell.counted? ? "#{cell.free_courts}/#{cell.total_courts}" : "✓" %>
                </a>
              </td>
            <% else %>
              <%# Nothing to book, so the only useful thing a tap can do is ask
                  to be told when there is. One button, no form to fill in —
                  and none at all on an hour that has already been and gone,
                  which nothing can free up any more. %>
              <td class="taken">
                <% if askable?(at) %>
                  <form method="post" action="/watches/dated">
                    <input type="hidden" name="club_slug" value="<%= row.club_slug %>">
                    <input type="hidden" name="starts_at" value="<%= at.iso8601 %>">
                    <%# The page, which an hour after midnight does not share. %>
                    <input type="hidden" name="date" value="<%= @date %>">
                    <button aria-label="Ask about <%= row.club_name %> at <%= hour_label(at) %>:00">·</button>
                  </form>
                <% else %>
                  <span aria-label="taken">·</span>
                <% end %>
              </td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="muted legend">
  <span class="swatch free">✓</span> free ·
  <span class="swatch taken">·</span> taken ·
  numbers are free courts of all courts
</p>
