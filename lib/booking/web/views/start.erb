<%#
  Telegram puts initData in the URL fragment, which browsers never send
  upstream, so the only way the server can see it is if this page posts it
  back. Then we reload, and the real page is served on the session that
  exchange produced. Inside Telegram this flashes past; opened anywhere else
  it is the splash that says where the app lives, and the line under the
  headline says what went wrong if anything did.

  The script is inline rather than in app.js so the exchange costs no extra
  round trip before anyone is signed in.
%>
<main class="splash">
  <%= court(:splash, "splash__court") %>
  <span class="brand"><%= ball(size: 34, outline: false) %><span class="brand__word">KORTULI</span></span>
  <div class="splash__copy">
    <h1 class="splash__title">Find a<br><span>free court.</span><br>Play tonight.</h1>
    <p class="splash__lede" id="status">Opening…</p>
    <noscript><p class="splash__lede">This app needs JavaScript to tell Telegram who you are.</p></noscript>
  </div>
  <div class="splash__foot">
    <a class="btn" href="<%= h(bot_url) %>"><%= icon(:send) %>Open @<%= h(settings.bot_username) %></a>
    <p class="splash__note">Never books or pays — it links you to the club.</p>
  </div>
</main>

<script>
  (function () {
    var status = document.getElementById("status");
    var payload = window.Telegram && Telegram.WebApp && Telegram.WebApp.initData;
    if (!payload) {
      status.textContent = "Kortuli lives inside Telegram. Open it from the bot to see free padel courts across Tbilisi.";
      return;
    }

    fetch("/auth", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "init_data=" + encodeURIComponent(payload)
    }).then(function (r) {
      if (r.ok) {
        // Replace rather than assign: this page must not sit in the back stack.
        window.location.replace("/");
      } else {
        status.textContent = "Telegram did not vouch for this session.";
      }
    }).catch(function () {
      status.textContent = "Could not reach the server.";
    });
  })();
</script>
