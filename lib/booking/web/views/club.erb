<%#
  One club's Profile: what its courts are under, where it is, the hours and
  prices it lists. None of it is ours — it is the club's own directory
  listing — so the screen says where it came from, and the free hours stay on
  the date screens, which read the booking system instead; the dock leads
  back to them, and out to the club's own booking page.

  Covers are the point of a Profile, so each court's tile names its Cover,
  and a court under a roof is drawn dark, as a roofed club's initials are in
  the directory. Over the Google Maps link, map.js draws the club's own pin
  on a still map; until it has, and without it, a drawing stands in. Either
  way the whole card is the link, and the place is wherever it lands.

  The star in the corner makes the club a Favourite, as the one beside its
  name on a date's list does, and turns over here.
%>
<% courts = courts_stat(@club.slug) %>
<% price = price_parts(@club.slug) %>
<% runs = @profile&.hour_runs.to_a %>
<% daily = runs.size == 1 && runs.first[0] == "mon" && runs.first[1] == "sun" %>
<% favourite = favourite?(@club.slug) %>
<main>
  <section class="profile-hero">
    <%= court(:profile, "profile-hero__court") %>
    <div class="profile-hero__bar">
      <a class="icon-btn" href="<%= @back %>" aria-label="Back"><%= icon(:back) %></a>
      <form class="fav" method="post" action="/favourites/<%= @club.slug %><%= "/delete" if favourite %>">
        <input type="hidden" name="back" value="profile">
        <% if @date %><input type="hidden" name="date" value="<%= @date %>"><% end %>
        <button class="fav__star<%= " is-on" if favourite %>" aria-pressed="<%= favourite %>"
                aria-label="<%= favourite ? Booking::Messages.favourite_remove : Booking::Messages.favourite_add %>"><%= star(size: 20) %></button>
      </form>
    </div>
    <h1 class="profile-hero__name"><%= h(@club.name) %></h1>
    <% if @profile&.area %>
      <div class="profile-hero__area"><%= icon(:pin, size: 14) %><%= h(@profile.area) %></div>
    <% end %>
    <% if courts || price || daily %>
      <div class="profile-hero__stats">
        <% if courts %>
          <div><div class="profile-hero__n"><%= courts.first %></div><div class="profile-hero__what"><%= courts.last %></div></div>
        <% end %>
        <% if price %>
          <div><div class="profile-hero__n"><%= h(price.first) %></div><div class="profile-hero__what"><%= h(price.last) %> / hour</div></div>
        <% end %>
        <% if daily %>
          <div><div class="profile-hero__n"><%= h(runs.first[2].gsub(":00", "")) %></div><div class="profile-hero__what">every day</div></div>
        <% end %>
      </div>
    <% end %>
  </section>

  <div class="page page--roomy profile">
    <% if @profile.nil? %>
      <p class="note"><%= Booking::Messages.profile_missing %></p>
    <% else %>
      <% if @profile.courts.any? %>
        <section class="section">
          <h2 class="field__label">Courts · <%= Booking::Messages.cover_summary(@profile.covers) %></h2>
          <ul class="courts">
            <% @profile.courts.each do |court| %>
              <li class="court<%= " is-roofed" unless court.cover == "outdoor" %>">
                <%= court_tile %>
                <span class="court__name"><%= h(court.name) %></span>
                <span class="cover cover--<%= h(court.cover) %>"><%= Booking::Messages.cover_label(court.cover) %></span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @profile.located? %>
        <%# The area is the name a person knows the place by; the street, when
            the listing has one that says more, goes under it. %>
        <% place = @profile.area || @profile.address %>
        <a class="place" data-external href="<%= h(@profile.maps_url) %>" target="_blank" rel="noopener">
          <span class="place__map" data-map-preview data-lat="<%= @profile.lat %>" data-lng="<%= @profile.lng %>">
            <%= place_art %>
            <span class="pin pin--selected place__pin-mark" aria-hidden="true" hidden>
              <span class="pin__pill"><span class="pin__short"><%= h(@club.short_name) %></span></span>
              <svg class="pin__tail" width="12" height="7" viewBox="0 0 12 7"><path d="M0 0 L6 7 L12 0 Z"/></svg>
            </span>
            <span class="place__credit" hidden>© OpenStreetMap · OpenFreeMap</span>
          </span>
          <span class="place__row">
            <span class="place__words">
              <span class="place__name"><%= h([place, "Open in Google Maps"].compact.join(" · ")) %></span>
              <% if @profile.address && @profile.address != place %>
                <span class="place__address"><%= h(@profile.address) %></span>
              <% end %>
            </span>
            <span class="place__go"><%= icon(:external, size: 16) %></span>
          </span>
        </a>
      <% elsif @profile.address %>
        <section class="info-card">
          <div class="info-row"><span class="info-row__what">Where</span><span class="info-row__value"><%= h(@profile.address) %></span></div>
        </section>
      <% end %>

      <% if runs.any? || @profile.prices.any? || @profile.phone %>
        <section class="info-card">
          <% runs.each do |first, last, hours| %>
            <div class="info-row">
              <span class="info-row__what">Hours</span>
              <span class="info-row__value"><%= Booking::Messages.day_run(first, last) %> <%= h(hours) %></span>
            </div>
          <% end %>
          <% @profile.prices.each do |listed| %>
            <div class="info-row">
              <span class="info-row__what">Price · per court, per hour</span>
              <span class="info-row__value"><%= h(Booking::Messages.price_line(listed)) %></span>
            </div>
          <% end %>
          <% if @profile.phone %>
            <a class="info-row" href="tel:<%= h(@profile.phone.delete(" ")) %>">
              <span class="info-row__what">Phone</span>
              <span class="info-row__value is-link"><%= h(@profile.phone) %></span>
            </a>
          <% end %>
        </section>
      <% end %>

      <% if @profile.listed? %>
        <%# The directory's name is the link to the club's own page on it. %>
        <% said = h(Booking::Messages.profile_source(@profile.checked_on)) %>
        <% said = said.sub("sapadelo.com", %(<a data-external href="#{h(@profile.source)}" target="_blank" rel="noopener">sapadelo.com</a>)) %>
        <p class="disclaimer"><%= said %></p>
      <% else %>
        <%# Only a pin of ours: nothing the club listed to vouch for. %>
        <p class="note"><%= Booking::Messages.profile_missing %></p>
      <% end %>
    <% end %>
  </div>
</main>

<div class="dock <%= @club.settings["booking_url"] ? "dock--even" : "" %>">
  <a class="btn btn--outline" href="/date/<%= @date || horizon.first %>/club/<%= @club.slug %>"><%= @date ? "Free hours" : "Free hours today" %></a>
  <% if @club.settings["booking_url"] %>
    <a class="btn btn--ball" data-external href="<%= h(@club.settings["booking_url"]) %>" target="_blank" rel="noopener">Book a court <%= icon(:external, size: 16) %></a>
  <% end %>
</div>
