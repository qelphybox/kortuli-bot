<%#
  Every hour a single club sells on one date, as a tile: free or taken, and
  the Forecast for it — the rain is what decides between this club and one
  with a roof. On a day with any, a strip over the tiles says when, and
  whether this club has open courts for it to fall on. The header is the
  club: its name is the link to its Profile, the line under it says what it
  is and costs, and the star beside it makes it a Favourite.

  Three things to do here, in that order. Book, always, at the bottom: out
  to the club's own page, once rather than on every free tile, because every
  tile would point at the same page. Share my game, once an hour is ticked:
  every hour not yet over can be ticked, free or taken — the Grid may not
  have seen a booking yet — and the ticked ones become a Game. Each tile is
  a label around its checkbox, and the boxes belong to the form in the dock
  by its id, so ticking works without JavaScript.
%>
<header class="bar">
  <div class="bar__row">
    <a class="icon-btn" href="<%= h(@back) %>" aria-label="Back to clubs"><%= icon(:back) %></a>
    <a class="bar__title bar__link" href="/clubs/<%= @club_slug %>?date=<%= @date %>">
      <h1 class="bar__h1"><%= @club_name %></h1>
      <div class="bar__sub"><%= h(@about) %></div>
    </a>
    <form class="fav" method="post" action="/favourites/<%= @club_slug %><%= "/delete" if @favourite %>">
      <input type="hidden" name="date" value="<%= @date %>">
      <input type="hidden" name="back" value="hours">
      <button class="fav-btn<%= " is-on" if @favourite %>" aria-pressed="<%= @favourite %>"
              aria-label="<%= @favourite ? Booking::Messages.favourite_remove : Booking::Messages.favourite_add %>"><%= star(size: 22) %></button>
    </form>
  </div>
</header>

<main class="page">
  <div class="hint-row">
    <p>Booked? Tick your hours to share.</p>
    <div class="legend"><span class="is-free">Free</span><span class="is-taken">Taken</span></div>
  </div>

  <% if @outlook && (@outlook.wet? || @outlook.damp?) %>
    <div class="notice notice--slim"><%= icon(:rain, size: 16) %><%= Booking::Messages.weather_headline(@outlook) %><%= " · outdoor courts" if @open_courts %></div>
  <% end %>

  <div class="hours slots">
    <% @slots.each do |s| %>
      <label class="hour <%= s[:free] ? "is-free" : "is-taken" %><%= " is-past" unless s[:pickable] %>">
        <span class="hour__top">
          <span class="hour__time"><%= s[:label] %></span>
          <% if s[:pickable] %>
            <input class="hour__pick" type="checkbox" name="hours[]" value="<%= s[:hour] %>" form="game-pick"
                   aria-label="I booked <%= @club_name %> at <%= s[:time] %>">
          <% end %>
        </span>
        <span class="hour__state hour__state--plain"><%= s[:state] %></span>
        <span class="hour__state hour__state--mine">My game</span>
        <% if (hour = s[:weather]) %>
          <span class="hour__weather<%= " is-wet" if hour.wet? %><%= " is-damp" if hour.damp? %>" title="<%= Booking::Messages.weather_tag(hour) %>"><%= hour_weather(hour) %></span>
        <% end %>
      </label>
    <% end %>
  </div>

  <%= erb :_feedback, locals: { label: Booking::Messages.feedback_pill_slots } %>
</main>

<form class="game-pick dock" id="game-pick" method="get" action="/date/<%= @date %>/club/<%= @club_slug %>/game">
  <% if @booking_url %>
    <a class="btn btn--ball btn--big" data-external href="<%= @booking_url %>" data-book="<%= @date %>">Book at <%= @club_name %> <%= icon(:external, size: 16) %></a>
  <% end %>
  <button class="btn btn--outline" type="submit" data-game-pick><%= icon(:share, size: 16) %><span><%= Booking::Messages.game_pick %></span></button>
</form>
