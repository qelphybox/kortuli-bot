<%#
  Every hour a single club sells on one date, as a tile: free or taken, and
  the Forecast for it — the rain is what decides between this club and one
  with a roof. The club's booking page is a single button in the header
  rather than one on every free tile, because every tile would point at the
  same page.

  Every hour not yet over can be ticked, free or taken — the Grid may not
  have seen a booking yet — and the ticked ones become a Game to share. Each
  tile is a label around its checkbox, and the boxes belong to the form in
  the dock by its id, so ticking works without JavaScript.
%>
<header class="bar">
  <div class="bar__row">
    <a class="icon-btn" href="/date/<%= @date %>" aria-label="Back to clubs"><%= icon(:back) %></a>
    <div class="bar__title">
      <h1 class="bar__h1"><%= @club_name %></h1>
      <div class="bar__sub"><%= [@weekday, @date_label, @area].compact.join(" · ") %></div>
    </div>
    <a class="icon-btn" href="/clubs/<%= @club_slug %>?date=<%= @date %>" aria-label="About <%= @club_name %>"><%= icon(:info) %></a>
    <% if @booking_url %>
      <a class="pill pill--ball" data-external href="<%= @booking_url %>"
         aria-label="Book at <%= @club_name %>">Book <%= icon(:external, size: 16) %></a>
    <% end %>
  </div>
  <div class="stats">
    <div class="stat stat--slab">
      <div class="stat__n"><%= @free_hours %></div>
      <div class="stat__what"><%= @free_hours == 1 ? "hour free" : "hours free" %></div>
    </div>
    <% if @price %>
      <div class="stat">
        <div class="stat__n"><%= @price.first %><% if @price.last %><small> <%= @price.last %></small><% end %></div>
        <div class="stat__what">per hour</div>
      </div>
    <% end %>
    <% if @courts %>
      <div class="stat">
        <div class="stat__n"><%= @courts.first %></div>
        <div class="stat__what"><%= @courts.last %></div>
      </div>
    <% end %>
  </div>
</header>

<main class="page">
  <div class="hint-row">
    <p>Booked some hours? Tick them and share with your group.</p>
    <div class="legend"><span class="is-free">Free</span><span class="is-taken">Taken</span></div>
  </div>

  <% if @outlook && (@outlook.wet? || @outlook.damp?) %>
    <div class="notice notice--slim"><%= icon(:rain, size: 16) %><%= Booking::Messages.weather_headline(@outlook) %></div>
  <% end %>

  <div class="hours slots">
    <% @slots.each do |s| %>
      <label class="hour <%= s[:free] ? "is-free" : "is-taken" %><%= " is-past" unless s[:pickable] %>">
        <span class="hour__top">
          <span class="hour__time"><%= s[:label] %></span>
          <% if s[:pickable] %>
            <input class="hour__pick" type="checkbox" name="hours[]" value="<%= s[:hour] %>" form="game-pick"
                   aria-label="I booked <%= @club_name %> at <%= s[:time] %>">
          <% end %>
        </span>
        <span class="hour__state hour__state--plain"><%= s[:state] %></span>
        <span class="hour__state hour__state--mine">My game</span>
        <% if (hour = s[:weather]) %>
          <span class="hour__weather<%= " is-wet" if hour.wet? %><%= " is-damp" if hour.damp? %>" title="<%= Booking::Messages.weather_tag(hour) %>"><%= hour_weather(hour) %></span>
        <% end %>
      </label>
    <% end %>
  </div>

  <%= erb :_feedback, locals: { label: Booking::Messages.feedback_pill_slots } %>
</main>

<form class="game-pick dock" id="game-pick" method="get" action="/date/<%= @date %>/club/<%= @club_slug %>/game">
  <button class="btn btn--slab" type="submit" data-game-pick
          data-none="<%= Booking::Messages.game_pick_none %>"><%= icon(:share, size: 18) %><span><%= Booking::Messages.game_pick %></span></button>
</form>
