<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>kortuli</title>
    <meta name="theme-color" content="#f4f6f1">
    <!-- Telegram's own SDK. It is the one script allowed to come from
         elsewhere: it is how the page learns who opened it and which colours
         to wear. -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Light or dark as the Telegram client is, before anything paints. A
         browser outside Telegram keeps the system's choice. -->
    <script>
      (function () {
        var tg = window.Telegram && Telegram.WebApp;
        if (tg && tg.initData && tg.colorScheme) document.documentElement.setAttribute("data-theme", tg.colorScheme);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Noto+Sans+Georgian:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= asset_url("/app.css") %>">
    <!-- One file per group of screens, so each can change without touching
         the others'. app.css holds the tokens and the parts they share. -->
    <% %w[city day share clubs map watching].each do |part| %>
      <link rel="stylesheet" href="<%= asset_url("/screens/#{part}.css") %>">
    <% end %>
    <!-- The map's renderer, on the screens that draw a map and nowhere
         else: kept with the app rather than fetched from a CDN. -->
    <% if @map %>
      <link rel="stylesheet" href="<%= asset_url("/vendor/maplibre/maplibre-gl.css") %>">
    <% end %>
  </head>
  <body>
    <%= yield %>
    <script src="<%= asset_url("/app.js") %>"></script>
    <% if @map %>
      <script src="<%= asset_url("/vendor/maplibre/maplibre-gl.js") %>"></script>
      <script src="<%= asset_url("/map.js") %>"></script>
    <% end %>
  </body>
</html>
