<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>kortuli</title>
    <meta name="theme-color" content="#f4f6f1">
    <!-- Telegram's own SDK. It is the one script allowed to come from
         elsewhere: it is how the page learns who opened it and which colours
         to wear. -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Light or dark as the Telegram client is, before anything paints. A
         browser outside Telegram keeps the system's choice. -->
    <script>
      (function () {
        var tg = window.Telegram && Telegram.WebApp;
        if (tg && tg.initData && tg.colorScheme) document.documentElement.setAttribute("data-theme", tg.colorScheme);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= asset_url("/app.css") %>">
  </head>
  <body>
    <%= yield %>
    <script src="<%= asset_url("/app.js") %>"></script>
  </body>
</html>
