<%#
  Hours this person booked, as the message their group gets. The two pickers
  fix the stretch — one GET form, so the span lives in the URL like the Share
  screen's. The preview draws what the message says the way the chat will
  read it, from the same Game; the words that leave, exactly, sit beside it
  for the copy button. The link at the message's end is the Game's own page,
  where everybody in the chat can put it in a calendar. Below the preview,
  the same two calendar buttons for the person sending it.
%>
<header class="bar">
  <div class="bar__row">
    <a class="icon-btn" href="/date/<%= @date %>/club/<%= h(@club.slug) %>" aria-label="Back to the hours"><%= icon(:back) %></a>
    <div class="bar__title">
      <div class="eyebrow">Booked · <%= @weekday %>, <%= @date_label %></div>
      <h1 class="bar__h1"><%= h(@club.name) %></h1>
    </div>
  </div>
</header>

<main class="page game-page">
  <form class="field-row" method="get" action="/date/<%= @date %>/club/<%= h(@club.slug) %>/game" data-autosubmit>
    <label class="field">
      <span class="field__label">From</span>
      <span class="select">
        <select name="from">
          <% @span.from_choices.each do |hour| %>
            <option value="<%= hour %>"<%= " selected" if hour == @span.from %>><%= @span.label(hour) %></option>
          <% end %>
        </select>
      </span>
    </label>
    <label class="field">
      <span class="field__label">To</span>
      <span class="select">
        <select name="to">
          <% @span.to_choices.each do |hour| %>
            <option value="<%= hour %>"<%= " selected" if hour == @span.to %>><%= @span.label(hour) %></option>
          <% end %>
        </select>
      </span>
    </label>
    <button class="btn btn--quiet apply no-js-only" type="submit">Show</button>
  </form>

  <section class="section" aria-label="Message preview">
    <div class="field__label">Your group will see</div>
    <div class="bubble">
      <div class="bubble__head">
        <div class="bubble__kicker">Court booked</div>
        <div class="bubble__title"><%= h(Booking::Messages.game_when(@game).sub(", ", " · ")) %></div>
        <div class="bubble__place"><%= h(@game.club_name) %></div>
      </div>
      <%= erb :_game_facts, locals: { game: @game, weather: @weather, city: nil } %>
      <div class="bubble__foot">
        Add to calendar: <%= h(bare_url(@game.card_url)) %><br>via <%= h(bare_url(bot_url)) %>
      </div>
    </div>
    <pre class="copy-source" id="game"><%= h(copy_text(@text)) %></pre>
  </section>

  <section class="section">
    <div class="field__label">Add to my calendar</div>
    <div class="btn-row">
      <a class="btn btn--quiet" data-external href="<%= h(Booking::Calendar.google_url(@event)) %>"
         target="_blank" rel="noopener"><%= icon(:calendar, size: 16) %>Google</a>
      <a class="btn btn--quiet" data-external href="<%= h(@game.card_url) %>.ics"
         target="_blank" rel="noopener"><%= icon(:calendar, size: 16) %>Apple &amp; other</a>
    </div>
  </section>
</main>

<div class="dock dock--split">
  <button class="btn btn--outline" type="button" data-copy="#game"
          data-copied="<%= Booking::Messages.share_copied %>"><%= Booking::Messages.share_copy %></button>
  <a class="btn btn--ball" data-tg-share href="<%= h(share_url(@text)) %>" target="_blank" rel="noopener">
    <%= icon(:send) %><%= Booking::Messages.share_send %>
  </a>
</div>
