<%#
  Hours this person booked, as the message their group gets. The two pickers
  fix the stretch — one GET form, so the span lives in the URL like the Share
  screen's. The preview is exactly what leaves; the link at its end is the
  Game's own page, where everybody in the chat can put it in a calendar.
  Below it, the same two calendar buttons for the person sending it.
%>
<header class="app-head app-head--sub">
  <a class="back" href="/date/<%= @date %>/club/<%= h(@club.slug) %>" aria-label="Back to the hours">←</a>
  <span class="app-head__title">
    <span class="app-head__club">Booked · <%= h(@club.name) %></span>
    <span class="app-head__sub"><%= @weekday %> · <%= @date_label %></span>
  </span>
</header>

<section class="share">
  <form class="share__form" method="get" action="/date/<%= @date %>/club/<%= h(@club.slug) %>/game" data-autosubmit>
    <div class="share__span">
      <label>
        From
        <select name="from">
          <% @span.from_choices.each do |hour| %>
            <option value="<%= hour %>"<%= " selected" if hour == @span.from %>><%= @span.label(hour) %></option>
          <% end %>
        </select>
      </label>
      <span class="dash" aria-hidden="true">–</span>
      <label>
        To
        <select name="to">
          <% @span.to_choices.each do |hour| %>
            <option value="<%= hour %>"<%= " selected" if hour == @span.to %>><%= @span.label(hour) %></option>
          <% end %>
        </select>
      </label>
      <button class="share__apply" type="submit">Show</button>
    </div>
  </form>

  <pre class="share__preview" id="game"><%= h(copy_text(@text)) %></pre>

  <a class="cta" data-tg-share href="<%= h(share_url(@text)) %>" target="_blank" rel="noopener">
    <%= Booking::Messages.share_send %>
  </a>
  <button class="btn-secondary" type="button" data-copy="#game"
          data-copied="<%= Booking::Messages.share_copied %>"><%= Booking::Messages.share_copy %></button>

  <div class="calendar-add">
    <h2 class="profile__label">Add to my calendar</h2>
    <div class="calendar-add__row">
      <a class="btn-secondary" data-external href="<%= h(Booking::Calendar.google_url(@event)) %>"
         target="_blank" rel="noopener"><%= Booking::Messages.game_to_google %></a>
      <a class="btn-secondary" data-external href="<%= h(@game.card_url) %>.ics"
         target="_blank" rel="noopener"><%= Booking::Messages.game_to_ics %></a>
    </div>
  </div>
</section>
