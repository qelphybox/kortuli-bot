<%#
  One club per row for a single date. Rows have the earliest free hour and
  the number of hours that are still open; a club with nothing open is
  dimmed and drops to the bottom, because the eye is hunting the ones that
  do have something. The star beside each row is where Favourites are made:
  a form post, like everything else that changes something, and outside the
  row's link so tapping it never opens the club. Beside each name, what its
  courts are under, from the club's Profile — the first thing anybody asks
  when it rains. Above the list, the Forecast for the hours still to come;
  on a wet one the clubs entirely in the open have already sunk, and the
  line says so.
%>
<header class="app-head app-head--sub">
  <a class="back" href="/" aria-label="Back to dates">←</a>
  <span class="app-head__title">
    <span class="app-head__weekday"><%= @weekday %></span>
    <span class="app-head__date"><%= @date_label %></span>
  </span>
  <a class="head-action" href="/date/<%= @date %>/share">Share</a>
</header>

<% if @outlook %>
  <p class="weather<%= " is-wet" if @outlook.wet? %>">
    <span><%= Booking::Messages.weather_outlook(@outlook) %></span>
    <% if @outlook.wet? %><span class="weather__note"><%= Booking::Messages.weather_roofed_first %></span><% end %>
  </p>
<% end %>

<ul class="clubs">
  <% @clubs.each do |c| %>
    <li class="club-item">
      <form class="fav" method="post" action="/favourites/<%= c[:slug] %><%= "/delete" if c[:favourite] %>">
        <input type="hidden" name="date" value="<%= @date %>">
        <button class="fav__star<%= " is-on" if c[:favourite] %>" aria-pressed="<%= c[:favourite] %>"
                aria-label="<%= c[:favourite] ? Booking::Messages.favourite_remove : Booking::Messages.favourite_add %>"><%= c[:favourite] ? "★" : "☆" %></button>
      </form>
      <a class="club-row<%= " is-empty" unless c[:any_free] %>" href="/date/<%= @date %>/club/<%= c[:slug] %>">
        <span class="club-row__body">
          <span class="club-row__head">
            <span class="club-row__name"><%= c[:name] %></span>
            <% if c[:cover] %><span class="club-row__cover"><%= c[:cover] %></span><% end %>
          </span>
          <span class="club-row__sub"><%= c[:sub] %></span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
    </li>
  <% end %>
</ul>

<%= erb :_feedback, locals: { label: Booking::Messages.feedback_pill_clubs } %>
