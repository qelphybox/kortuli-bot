<%#
  One date's clubs, against the hours somebody wants to play. Under the
  week's strip, one strip of the day's hours still to come: a tap picks an
  hour or lets it go, and the list answers for exactly those. The hours live
  in the URL, so a day tapped on the strip, a club's hours and the way back
  all keep them; app.js swaps the list in place rather than reloading it.
  The rain is a blue line under its hours.

  A club is on the list only when every hour picked is free there — a
  two-hour game needs both. The rest fold into one line, each saying what
  it does have instead. Nothing picked is "any time": every club with an
  hour left, and its first few. Favourites lead, in the order they were
  starred; under rain the clubs with a roof come next.

  Only when rain falls on the hours picked, one line over the list offers a
  roof to book through it: the first club on the list that is indoors or
  covered and has a free hour in the rain — a favourite first. With no
  roof free, the line only says when it will rain; a dry span has no line
  at all. A whole card is one link, to the club's hours, where
  the star is.
%>
<% pick = @pick %>
<header class="bar day-bar">
  <div class="bar__row">
    <a class="icon-btn" href="/" aria-label="Back to the week"><%= icon(:back) %></a>
    <div class="bar__title bar__day">
      <h1 class="bar__h1"><%= @weekday.upcase %></h1>
      <span class="bar__date"><%= @date_label %> · <%= h(current_city) %></span>
    </div>
    <a class="pill pill--slab" href="/date/<%= @date %>/share"><%= icon(:share, size: 16) %>Share day</a>
  </div>
  <nav class="strip" aria-label="Days" data-day-swap="days">
    <% @strip.each do |s| %>
      <a class="strip__day<%= " is-wet" if s[:wet] %>" href="<%= h(day_path(s[:date], pick)) %>"<%= ' aria-current="date"' if s[:current] %>>
        <span class="strip__dow"><%= s[:weekday] %></span>
        <span class="strip__n"><%= s[:day] %></span>
        <span class="strip__dot"></span>
      </a>
    <% end %>
  </nav>
  <% if pick.hours.any? %>
    <div class="when" data-day-swap="when">
      <span class="when__label"><%= icon(:clock, size: 13) %>When · <%= Booking::Messages.day_span(pick) %></span>
      <% if pick.any_rain? %><span class="when__rain">rain</span><% end %>
    </div>
    <nav class="hour-strip" aria-label="Hours you want to play" data-hour-strip data-day-swap="hours">
      <% pick.hours.each do |hour| %>
        <% on = pick.wanted.include?(hour) %>
        <a class="hour-chip<%= " is-rainy" if pick.rainy_hour?(hour) %>" role="button" aria-pressed="<%= on %>" data-hour="<%= hour %>"
           aria-label="<%= Booking::Messages.hour_clock(hour) %><%= ", rain" if pick.rainy_hour?(hour) %>"
           href="/date/<%= @date %><%= "?hours=#{pick.toggled(hour)}" if pick.toggled(hour) %>"><%= Booking::Messages.hour_chip(hour) %></a>
      <% end %>
    </nav>
  <% end %>
</header>

<main class="page day-list" data-day-swap="list">
  <% if pick.hours.empty? %>
    <p class="empty">Nothing left to book today — every club has shut for the night.</p>
  <% else %>
    <% if (hint = pick.hint) %>
      <% lead, rest = Booking::Messages.day_hint(pick) %>
      <% tag = hint.club ? "a" : "div" %>
      <<%= tag %> class="day-hint"<% if hint.club %> href="/date/<%= @date %>/club/<%= hint.club.slug %><%= "?hours=#{pick.param}" if pick.param %>"<% end %>>
        <span class="day-hint__icon"><%= icon(:rain, size: 18) %></span>
        <span class="day-hint__text"><strong><%= h(lead) %></strong><% if rest %> <%= h(rest) %><% end %></span>
        <% if hint.club %><span class="day-hint__cta">Book<%= icon(:chevron, size: 12) %></span><% end %>
      </<%= tag %>>
    <% end %>

    <p class="day-summary"><%= Booking::Messages.day_summary(pick) %></p>

    <ul class="day-clubs">
      <% pick.live.each do |club| %>
        <% card = day_card(club.slug) %>
        <li>
          <a class="day-club" href="/date/<%= @date %>/club/<%= club.slug %><%= "?hours=#{pick.param}" if pick.param %>">
            <span class="day-club__body">
              <span class="day-club__head">
                <% if club.favourite? %><span class="day-club__fav" role="img" aria-label="Favourite"><%= star(size: 16) %></span><% end %>
                <span class="day-club__name"><%= h(club.name) %></span>
              </span>
              <% if card[:covers].any? || !card[:sub].empty? %>
                <span class="day-club__meta">
                  <% card[:covers].each do |cover| %><span class="tag tag--<%= cover %>"><%= cover %></span><% end %>
                  <span class="day-club__sub"><%= h(card[:sub]) %></span>
                </span>
              <% end %>
              <% if pick.any_time? %>
                <span class="day-club__hours">
                  <% pick.chips(club).each do |hour| %>
                    <span class="free-chip<%= " is-wet" if club.open_air && pick.rainy_hour?(hour) %>"><%= Booking::Messages.hour_chip(hour) %></span>
                  <% end %>
                  <% if pick.more(club).positive? %><span class="free-chip__more">+<%= pick.more(club) %></span><% end %>
                </span>
              <% elsif (wet = Booking::Messages.day_wet(pick, club)) %>
                <span class="day-club__wet"><%= wet %></span>
              <% end %>
            </span>
            <span class="day-club__free">
              <% if pick.any_time? %>
                <span class="day-club__n"><%= pick.free_in(club).size %></span>
                <span class="day-club__unit"><%= pick.free_in(club).size == 1 ? "hour" : "hours" %></span>
              <% else %>
                <span class="day-club__n"><%= pick.span.size %>h</span>
                <span class="day-club__unit">free</span>
              <% end %>
              <%= icon(:chevron, size: 16) %>
            </span>
          </a>
        </li>
      <% end %>
    </ul>

    <% if pick.folded.any? %>
      <details class="fold">
        <summary class="fold__head"><span><%= Booking::Messages.day_folded(pick) %></span><%= icon(:chevron, size: 16) %></summary>
        <ul class="fold__list">
          <% pick.folded.each do |miss| %>
            <li>
              <a class="fold__club" href="/date/<%= @date %>/club/<%= miss.club.slug %><%= "?hours=#{pick.param}" if pick.param %>">
                <span class="fold__name"><%= h(miss.club.name) %></span>
                <span class="fold__why"><%= Booking::Messages.day_miss(miss) %></span>
              </a>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% end %>

  <%= erb :_feedback, locals: { label: Booking::Messages.feedback_pill_clubs } %>
</main>
