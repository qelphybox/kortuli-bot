<%#
  One club per row for a single date. Rows have the earliest free hour and
  the number of hours that are still open; a club with nothing open is
  dimmed and drops to the bottom, because the eye is hunting the ones that
  do have something.
%>
<header class="app-head app-head--sub">
  <a class="back" href="/" aria-label="Back to dates">←</a>
  <span class="app-head__title">
    <span class="app-head__weekday"><%= @weekday %></span>
    <span class="app-head__date"><%= @date_label %></span>
  </span>
</header>

<ul class="clubs">
  <% @clubs.each do |c| %>
    <li>
      <a class="club-row<%= " is-empty" unless c[:any_free] %>" href="/date/<%= @date %>/club/<%= c[:slug] %>">
        <span class="club-row__body">
          <span class="club-row__name"><%= c[:name] %></span>
          <span class="club-row__sub"><%= c[:sub] %></span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
    </li>
  <% end %>
</ul>
