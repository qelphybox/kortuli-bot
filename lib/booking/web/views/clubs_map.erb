<%#
  The City's clubs where they are: the directory, drawn on a map, not a
  search for slots. Each pin is the club's short name and a mark — a star
  for a Favourite, a roof, or a court — the Favourites in the ball's yellow,
  and a tap opens its card: where it is, its courts, price and hours, one
  grey line on what is left today, and the ways on — its hours, directions,
  its Profile.

  The server draws every pin and every card; map.js only puts the pins on
  the map and shows one card at a time. A club the listing gives no pin is
  not guessed at — the list still has it. The chips are in the URL, so a
  link keeps them.

  Without JavaScript there is no map to draw, and the page says so.
%>
<% today = @date == horizon.first %>
<header class="map-head">
  <div class="topbar topbar--tight">
    <h1 class="topbar__title">Clubs</h1>
    <%= erb :_city_switch, locals: { back: "/clubs/map", count: city_clubs.size } %>
  </div>
  <%= erb :_clubs_switch, locals: { current: :map } %>
</header>

<main class="map-screen" data-clubs-map
      data-centre="<%= @centre&.join(",") %>"
      aria-label="Map of <%= h(current_city) %> with padel clubs">
  <div class="map-canvas" data-map-canvas></div>

  <div class="map-tools js-only">
    <a class="map-chip" href="<%= h(map_path(only: @only == "covered" ? nil : "covered")) %>"<%= ' aria-current="true"' if @only == "covered" %>>Covered</a>
    <a class="map-chip" href="<%= h(map_path(only: @only == "favourites" ? nil : "favourites")) %>"<%= ' aria-current="true"' if @only == "favourites" %>><%= star(size: 12) %>Favs</a>
    <button class="map-locate" type="button" aria-label="Show my location" data-map-locate hidden><%= icon(:locate) %></button>
  </div>

  <div class="map-pins" hidden>
    <% @clubs.each do |c| %>
      <button type="button" class="pin pin--<%= c[:mark] %>" data-pin="<%= c[:slug] %>" data-lat="<%= c[:lat] %>" data-lng="<%= c[:lng] %>"
              aria-pressed="false" aria-label="<%= h([c[:name], c[:area], c[:courts].first && [c[:courts].first, c[:courts].last, "courts"].compact.join(" ")].compact.join(", ")) %>">
        <span class="pin__name"><%= h(c[:name]) %></span>
        <span class="pin__pill">
          <%= c[:mark] == :favourite ? star(size: 14) : icon(c[:mark], size: 14) %>
          <span class="pin__short"><%= h(c[:short]) %></span>
        </span>
        <svg class="pin__tail" width="12" height="7" viewBox="0 0 12 7" aria-hidden="true"><path d="M0 0 L6 7 L12 0 Z"/></svg>
      </button>
    <% end %>
  </div>

  <div class="map-foot">
    <div class="map-attr js-only">
      <button class="map-attr__i" type="button" aria-expanded="false" aria-label="Map attribution" data-map-attr>i</button>
      <span class="map-attr__text" hidden>
        <a data-external href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap contributors</a> ·
        <a data-external href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> ·
        <a data-external href="https://www.openmaptiles.org/" target="_blank" rel="noopener">© OpenMapTiles</a>
      </span>
    </div>

    <p class="map-hint js-only" data-map-hint>
      <% if @clubs.empty? %>
        <%= case @only
            when "favourites" then "No favourites yet — star a club in the list"
            when "covered" then "No club with a roof is on the map"
            else "No club here has a pin yet — see the list"
            end %>
      <% else %>
        Tap a pin to see the club
      <% end %>
    </p>
    <p class="map-hint no-js-only">The map needs JavaScript. <a href="/clubs">See the list</a></p>

    <% @clubs.each do |c| %>
      <section class="map-card" data-card="<%= c[:slug] %>" aria-label="<%= h(c[:name]) %>" hidden>
        <span class="map-card__grip" aria-hidden="true"></span>
        <div class="map-card__head">
          <div class="map-card__title">
            <h2 class="map-card__name"><span><%= h(c[:name]) %></span><% if c[:favourite] %><%= star(size: 16) %><span class="visually-hidden">Favourite</span><% end %></h2>
            <div class="map-card__meta"><%= c[:area] ? h(c[:area]) : "No directory profile yet" %></div>
          </div>
          <button class="map-card__close" type="button" aria-label="Close" data-card-close><%= icon(:close, size: 16) %></button>
        </div>
        <dl class="map-card__tiles">
          <div class="map-tile">
            <dt>Courts</dt>
            <dd><%= c[:courts].first || "—" %><% if c[:courts].last %> <small class="is-cover"><%= c[:courts].last %></small><% end %></dd>
          </div>
          <div class="map-tile">
            <dt>Price</dt>
            <dd><% if c[:price] %><%= h(c[:price].first) %> <small><%= h(c[:price].last) %>/h</small><% else %>—<% end %></dd>
          </div>
          <div class="map-tile">
            <dt>Open</dt>
            <dd><%= c[:open] %></dd>
          </div>
        </dl>
        <p class="map-card__slots">Slots <%= today ? "today" : "tomorrow" %>: <%= c[:slots] %></p>
        <div class="map-card__actions">
          <a class="btn btn--ball map-card__btn" href="/date/<%= @date %>/club/<%= c[:slug] %>"><%= today ? "Hours today" : "Hours tomorrow" %></a>
          <a class="btn btn--outline map-card__btn" data-external href="<%= h(c[:maps_url]) %>" target="_blank" rel="noopener">Directions <%= icon(:external, size: 13) %></a>
          <a class="map-card__more" href="/clubs/<%= c[:slug] %>?from=map" aria-label="Club profile"><%= icon(:info, size: 18) %></a>
        </div>
      </section>
    <% end %>
  </div>
</main>

<%= erb :_tabs, locals: { current: :clubs } %>
