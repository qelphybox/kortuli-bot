<%#
  One step, not four messages: clubs, weekdays and both ends of the range
  go up together. Checkboxes drawn as chips and day squares rather than a
  typed list, so a club that is not watched cannot be asked for. What was
  picked is rendered back, because a refusal that also empties the form
  punishes the person for reading it. The Weekdays and Weekend shortcuts
  only tick boxes, and only exist once JavaScript runs.

  The City is picked inside the form rather than from the header's pill:
  every city's clubs are on the page, grouped, so changing city costs no
  round trip and loses no ticks in the days and hours. Without JavaScript
  every group shows under its city's name. With it, the segment shows one
  group at a time and clears the ticks in the others when it changes, so a
  watch keeps to one city — a Watch names clubs, not a city, so one in each
  is two watches. The segment's own value goes up too, only so a refusal
  comes back on the city it was left on.
%>
<% refused_clubs = @refusals.include?(Booking::Messages.pick_at_least_one_club) %>
<% refused_days = @refusals.include?(Booking::Messages.pick_at_least_one_day) %>
<% picked = @club_groups.to_h { |city, clubs| [city, clubs.count { picked_club?(_1) }] } %>
<header class="bar">
  <div class="bar__row">
    <a class="icon-btn" href="/watches" aria-label="Back to watches"><%= icon(:back) %></a>
    <h1 class="bar__h1 bar__h1--caps">Watch a slot</h1>
  </div>
</header>

<form class="new-watch" method="post" action="/watches" data-watch-form>
  <main class="page page--wide-gap">
    <% if @refusals.any? %>
      <ul class="alerts refusals">
        <% @refusals.each do |reason| %>
          <li class="alert" role="alert"><%= icon(:alert) %><%= reason %></li>
        <% end %>
      </ul>
    <% end %>

    <% if city_switch? %>
      <fieldset class="group js-only">
        <legend class="field__label">City</legend>
        <div class="seg seg--city">
          <% cities.each do |city| %>
            <label>
              <input type="radio" name="city" value="<%= h(city) %>"<%= " checked" if city == form_city %> data-city-pick>
              <span><%= h(city) %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <fieldset class="group<%= " is-refused" if refused_clubs %>">
      <legend class="field__label">
        <% if city_switch? %>
          Clubs<span class="js-only"> in <span data-city-name><%= h(form_city) %></span> · <span data-picked><%= picked[form_city] %></span> picked</span>
        <% else %>
          Clubs in <%= h(form_city) %><span class="js-only"> · <span data-picked><%= picked[form_city] %></span> picked</span>
        <% end %>
      </legend>
      <div class="club-groups">
        <% @club_groups.each do |city, clubs| %>
          <div class="club-group" data-city="<%= h(city) %>">
            <% if city_switch? %><h2 class="club-group__city"><%= h(city) %></h2><% end %>
            <div class="pick-list">
              <% clubs.each do |club| %>
                <label class="toggle-chip">
                  <input type="checkbox" name="club_slugs[]" value="<%= club.slug %>"<%= " checked" if picked_club?(club) %>>
                  <span><%= h(club.name) %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="group<%= " is-refused" if refused_days %>">
      <legend class="field__label">Days</legend>
      <div class="day-picks">
        <% weekday_choices.each do |day, name| %>
          <label class="day-pick">
            <input type="checkbox" name="weekdays[]" value="<%= day %>"<%= " checked" if picked_day?(day) %> aria-label="<%= name %>">
            <span aria-hidden="true"><%= name[0] %></span>
          </label>
        <% end %>
      </div>
      <div class="presets js-only">
        <button type="button" data-days="1,2,3,4,5">Weekdays</button>
        <button type="button" data-days="6,0">Weekend</button>
      </div>
    </fieldset>

    <fieldset class="group">
      <legend class="field__label">Time window</legend>
      <div class="field-row">
        <label class="field">
          <span class="field__label field__label--soft">From</span>
          <span class="select">
            <select name="from_hour">
              <% start_hours.each do |hour| %>
                <option value="<%= hour %>"<%= " selected" if picked_hour?(hour, :from_hour) %>><%= clock(hour) %></option>
              <% end %>
            </select>
          </span>
        </label>
        <label class="field">
          <span class="field__label field__label--soft">Until</span>
          <span class="select">
            <select name="to_hour">
              <% end_hours.each do |hour| %>
                <option value="<%= hour %>"<%= " selected" if picked_hour?(hour, :to_hour) %>><%= clock(hour) %></option>
              <% end %>
            </select>
          </span>
        </label>
      </div>
    </fieldset>
  </main>

  <div class="dock">
    <button class="btn btn--ball cta"><%= icon(:bell, size: 18) %>Start watching</button>
    <p class="dock__note">Kortuli never books or pays. You get a message with a link.</p>
  </div>
</form>
