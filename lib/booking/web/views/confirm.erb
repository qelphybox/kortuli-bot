<%#
  The moment after the form is accepted, before the list. Post-redirect-get
  lands here rather than at the list itself so the affirmation — "we will
  ping you" — arrives attached to what was just created, and a refresh
  quietly re-renders the card rather than creating a second watch.
%>
<main class="done">
  <div class="done__main">
    <%= done %>
    <h1 class="done__title">You're on<br>the lookout</h1>
    <p class="done__lede">We'll ping you on Telegram the moment a slot opens.</p>
    <div class="done__card">
      <div class="watch__top">
        <span class="state-pill">Watching</span>
        <span class="watch__time"><%= Booking::Messages.time_range(@watch) %></span>
      </div>
      <div class="watch__clubs"><%= h(watch_clubs(@watch)) %></div>
      <div class="watch__when"><%= watch_days(@watch, sep: " · ") %></div>
    </div>
  </div>
  <div class="done__actions">
    <a class="btn btn--ball" href="/watches">Manage watches</a>
    <a class="btn btn--outline" href="/">Back to dates</a>
  </div>
</main>
