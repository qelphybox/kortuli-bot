<%#
  The home screen. One row per day of the horizon, from today outward. Each
  row is a link into the day: tapping it opens the list of clubs that have
  anything open then. A day with nothing open is dimmed rather than hidden,
  so the eye reads "we did look and there was nothing" rather than "this
  club shut down".

  The dates are the whole screen on purpose: looking, sharing a Rundown and
  sharing a Game all start from one of them. Everything else — watches, the
  clubs directory, the owner's Dashboard — waits behind the Menu. It is a
  <details>, so it opens without JavaScript, like everything else here.
%>
<header class="app-head">
  <div class="app-head__row">
    <span class="brand">kortuli</span>
    <details class="menu" data-menu>
      <summary class="menu__toggle">
        <span aria-hidden="true">☰</span>
        <span>Menu</span>
      </summary>
      <nav class="menu__panel">
        <a class="menu__item" href="/watches">
          <span>Your watches</span>
          <% if @watches_count.positive? %><span class="menu__count"><%= @watches_count %></span><% end %>
        </a>
        <a class="menu__item" href="/watches/new">
          <span>Watch a slot</span>
          <span class="menu__hint">when it frees up</span>
        </a>
        <a class="menu__item" href="/clubs">
          <span>Clubs</span>
          <span class="menu__hint">courts, hours, map</span>
        </a>
        <% if @owner %>
          <a class="menu__item" href="/admin">
            <span>Dashboard</span>
            <span class="menu__hint">health, logs, disk</span>
          </a>
        <% end %>
      </nav>
    </details>
  </div>
  <p class="tagline">Open courts in Tbilisi. Pick a day, book it, tell your group.</p>
</header>

<ul class="dates">
  <% @dates.each do |d| %>
    <li>
      <a class="date-row<%= " is-empty" unless d[:any_free] %>" href="/date/<%= d[:date] %>">
        <span class="date-row__day">
          <span class="date-row__weekday">
            <span><%= d[:weekday] %></span>
            <% if d[:today] %><span class="badge">Today</span><% end %>
            <% if d[:weather] %><span class="date-row__weather" title="Rain in the forecast"><%= d[:weather] %></span><% end %>
          </span>
          <span class="date-row__date"><%= d[:date_label] %></span>
        </span>
        <span class="date-row__meta">
          <span class="date-row__headline<%= " is-empty" unless d[:any_free] %>"><%= d[:headline] %></span>
          <% if d[:sub] %>
            <span class="date-row__sub"><%= d[:sub] %></span>
          <% end %>
        </span>
      </a>
    </li>
  <% end %>
</ul>

<%= erb :_feedback, locals: { label: Booking::Messages.feedback_pill_dates } %>
