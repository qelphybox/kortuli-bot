<%#
  Everything this person has asked to be told about. Standing and Dated
  are one thing downstream, so they list together — the difference on
  screen is that a Dated watch names its one day, and says so. The form
  that creates a new one lives at its own URL now; the button below points
  at it.
%>
<header class="app-head app-head--sub">
  <a class="back" href="/" aria-label="Back to dates">←</a>
  <span class="app-head__title-solo">Your watches</span>
</header>

<% if @watches.empty? %>
  <p class="muted empty"><%= Booking::Messages.no_watches_in_app %></p>
<% else %>
  <ul class="watches">
    <% @watches.each do |watch| %>
      <li class="watch<%= " is-paused" unless watch.active? %>">
        <div class="watch__body">
          <p class="clubs">
            <span class="kind <%= watch_kind(watch) %>"><%= watch_kind(watch).capitalize %></span>
            <%= watch_clubs(watch) %>
          </p>
          <p class="when">
            <%= watch_when(watch) %><%= " · Paused" unless watch.active? %>
          </p>
        </div>
        <%# Ordinary form posts rather than fetch(): the session cookie is
            SameSite=Lax, so a form on somebody else's site cannot carry it,
            and the app needs no JavaScript to manage a watch. %>
        <div class="actions">
          <% if watch.active? %>
            <form method="post" action="/watches/<%= watch.id %>/pause"><button>Pause</button></form>
          <% else %>
            <form method="post" action="/watches/<%= watch.id %>/resume"><button>Resume</button></form>
          <% end %>
          <form method="post" action="/watches/<%= watch.id %>/delete"><button class="danger">Delete</button></form>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<div class="footer-cta">
  <a class="cta" href="/watches/new">+ Watch a slot</a>
</div>
