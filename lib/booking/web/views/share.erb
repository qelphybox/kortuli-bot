<%#
  One date's free courts as one message. Two switches in the bar: which
  clubs (every one, the Favourites, or a handful ticked by hand) and which
  hours (the whole day, or the evening in a tap). Any other span is under
  "Other hours", from the same two pickers as ever. One GET form — the bar's
  switch and the controls under it are joined to it by `form=` — so it all
  lives in the URL, a refresh keeps it, and changing one never drops the
  other. The hours switch is two links, because a span is two values and a
  radio carries one; each keeps the clubs.

  The preview draws the Rundown the way the chat will read it, from the same
  Sheet the message is written from; the words that leave, exactly, sit
  beside it for the copy button, and the share sheet sends the same.
%>
<% share_path = "/date/#{@date}/share" %>
<% evening = @span.evening %>
<% other_hours = !@span.whole_day? && !@span.evening? %>
<header class="bar">
  <div class="bar__row">
    <a class="icon-btn" href="/date/<%= @date %>" aria-label="Back to clubs"><%= icon(:back) %></a>
    <div class="bar__title">
      <div class="eyebrow">Share the day</div>
      <h1 class="bar__h1"><%= @weekday %> · <%= @date_label %></h1>
    </div>
  </div>

  <form class="share-switches" id="share" method="get" action="<%= share_path %>" data-autosubmit>
    <fieldset class="seg" aria-label="Clubs">
      <% [["all", Booking::Messages.share_all_clubs], ["favourites", Booking::Messages.share_favourites],
          ["picked", Booking::Messages.share_pick_clubs]].each do |mode, label| %>
        <label><input type="radio" name="only" value="<%= mode %>"<%= " checked" if @filter.mode == mode %>><span><%= label %></span></label>
      <% end %>
    </fieldset>
    <% if @span.hours.any? %>
      <div class="seg" role="group" aria-label="Hours">
        <a href="<%= share_path %><%= h(share_query(@filter)) %>"<%= ' aria-current="true"' if @span.whole_day? %>><%= Booking::Messages.share_all_day %></a>
        <% if evening %>
          <a href="<%= share_path %><%= h(share_query(@filter, evening)) %>"<%= ' aria-current="true"' if @span.evening? %>><%= evening.short_label %></a>
        <% end %>
      </div>
    <% end %>
  </form>
</header>

<main class="page share-page">
  <% if @filter.picked? %>
    <fieldset class="pick-list" aria-label="Which clubs">
      <% @clubs.each do |club| %>
        <label class="toggle-chip">
          <input type="checkbox" form="share" name="clubs[]" value="<%= club.slug %>"<%= " checked" if @filter.includes?(club.slug) %>>
          <span><%= "★ " if favourite?(club.slug) %><%= club.name %></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <% if @filter.no_favourites? %>
    <p class="note"><%= Booking::Messages.share_no_favourites %></p>
  <% end %>

  <% if @span.hours.any? %>
    <details class="share-hours"<%= " open" if other_hours %>>
      <summary><%= Booking::Messages.share_other_hours %><%= icon(:chevron, size: 16) %></summary>
      <div class="field-row">
        <label class="field">
          <span class="field__label">From</span>
          <span class="select select--small">
            <select form="share" name="from">
              <% @span.from_choices.each do |hour| %>
                <option value="<%= hour %>"<%= " selected" if hour == @span.from %>><%= @span.label(hour) %></option>
              <% end %>
            </select>
          </span>
        </label>
        <label class="field">
          <span class="field__label">To</span>
          <span class="select select--small">
            <select form="share" name="to">
              <% @span.to_choices.each do |hour| %>
                <option value="<%= hour %>"<%= " selected" if hour == @span.to %>><%= @span.label(hour) %></option>
              <% end %>
            </select>
          </span>
        </label>
      </div>
    </details>
  <% end %>
  <button class="btn btn--quiet apply no-js-only" type="submit" form="share">Show</button>

  <section class="section" aria-label="Message preview">
    <div class="field__label">Message preview · <%= @sheet.entries.size %> <%= @sheet.entries.size == 1 ? "club" : "clubs" %></div>
    <div class="bubble">
      <div class="bubble__head">
        <div class="bubble__title bubble__title--day"><%= h(Booking::Messages.rundown_heading(@sheet).delete_prefix("🎾 ")) %></div>
        <% if @sheet.outlook %>
          <div class="bubble__note<%= " is-dry" unless @sheet.outlook.wet? || @sheet.outlook.damp? %>"><%= h(Booking::Messages.weather_brief(@sheet.outlook)) %></div>
        <% end %>
      </div>
      <% if @sheet.empty? %>
        <div class="bubble__foot bubble__foot--solo"><%= Booking::Messages.share_nothing %></div>
      <% else %>
        <ul class="bubble__rows">
          <% @sheet.entries.each do |entry| %>
            <li>
              <div class="bubble__row-head">
                <strong class="bubble__club"><%= h(entry.club_name) %></strong>
                <% if entry.price %><span class="bubble__price"><%= h(entry.price) %></span><% end %>
              </div>
              <div class="bubble__runs"><%= entry.runs.map { "#{Booking::Messages.local_clock(_1.starts_at)}–#{Booking::Messages.local_clock(_1.ends_at)}" }.join(" · ") %></div>
              <% if entry.link %><span class="bubble__link"><%= h(bare_url(entry.link)) %></span><% end %>
            </li>
          <% end %>
        </ul>
        <div class="bubble__foot">
          <% if @sheet.booked.any? %>Fully booked: <%= h(@sheet.booked.join(", ")) %><br><% end %>via <%= h(bare_url(bot_url)) %>
        </div>
      <% end %>
    </div>
    <pre class="copy-source" id="rundown"><%= h(copy_text(@text)) %></pre>
  </section>
</main>

<% unless @sheet.empty? %>
  <div class="dock dock--split">
    <button class="btn btn--outline" type="button" data-copy="#rundown"
            data-copied="<%= Booking::Messages.share_copied %>"><%= Booking::Messages.share_copy %></button>
    <a class="btn btn--ball" data-tg-share href="<%= h(share_url(@text)) %>" target="_blank" rel="noopener">
      <%= icon(:send) %><%= Booking::Messages.share_send %>
    </a>
  </div>
<% end %>
