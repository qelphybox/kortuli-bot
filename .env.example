# Required — from @BotFather
TELEGRAM_TOKEN=

# Required by the bot only — bin/bot refuses to boot without it. Where the mini
# app is served: the bot points its menu button and its greeting's button here.
# Telegram opens these over HTTPS only, so a local http:// URL will not work.
APP_URL=https://kortuli-tgapp.qelphybox.space

# Required by the bot and the web. The bot needs it to forward feedback (see
# ADR-0002); the web needs it to build the "Contact" pill's deeplink. Just
# the handle, no leading @. @BotFather says what it is.
BOT_USERNAME=

# Required by the bot and the web — the numeric Telegram user_id that receives
# forwarded feedback, and the only person the web's /admin dashboard opens
# for. Look yours up with @userinfobot. Both refuse to start with it unset
# rather than silently dropping bug reports.
OWNER_TELEGRAM_ID=

# Optional, shown here with their defaults.
# DATABASE_URL=sqlite://data/booking.db
# HORIZON_DAYS=7
# POLL_INTERVAL=4m
# POLL_JITTER=30
# HTTP_TIMEOUT=15
# CLUBS_FILE=config/clubs.yml
# PORT=8080
# WEB_THREADS=5
# LOG_DIR=data/log

# Goes into the User-Agent so a club owner can reach a human instead of
# silently blocking the IP.
CONTACT_EMAIL=

# Optional. Padel Academy shows its schedule only to a signed-in member, so the
# poller logs in as one. Unset, that club fails each tick and says why.
PADEL_ACADEMY_EMAIL=
PADEL_ACADEMY_PASSWORD=
