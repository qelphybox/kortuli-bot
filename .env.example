# Required — from @BotFather
TELEGRAM_TOKEN=

# Your Telegram numeric id. While this is set, nobody else can use the bot.
# Leave empty to let anyone in (only sensible if the token is not public).
OWNER_TELEGRAM_ID=

# Optional, shown here with their defaults.
# DATABASE_URL=sqlite://data/booking.db
# HORIZON_DAYS=7
# POLL_INTERVAL=4m
# POLL_JITTER=30
# HTTP_TIMEOUT=15
# CLUBS_FILE=config/clubs.yml

# Goes into the User-Agent so a club owner can reach a human instead of
# silently blocking the IP.
CONTACT_EMAIL=
