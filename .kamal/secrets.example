# Read by Kamal at deploy time and never baked into the image. This file is
# gitignored; keep the real values in your password manager, not here.
#
# KAMAL_REGISTRY_PASSWORD is a GitHub PAT with `write:packages`. The token that
# `gh` already holds does not have that scope, so it will not do.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
TELEGRAM_TOKEN=$TELEGRAM_TOKEN
CONTACT_EMAIL=$CONTACT_EMAIL
# Signs the mini app's session cookies. Generate once with `openssl rand -hex 32`.
SESSION_SECRET=$SESSION_SECRET
