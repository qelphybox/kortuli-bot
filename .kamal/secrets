# Committed on purpose: it holds no values, only the names Kamal reads and
# where each one comes from — the environment of whoever runs the deploy. In CI
# that is .github/workflows/deploy.yml, which maps repository secrets onto
# these names. Locally, export them in your shell before `kamal deploy`.
#
# Never put a literal value here. A missing variable expands to an empty string
# rather than failing, which is why the workflow checks for empties itself.

# In CI this is the run's own GITHUB_TOKEN. From a laptop it has to be a PAT
# with `write:packages`; the token `gh` already holds lacks that scope.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
TELEGRAM_TOKEN=$TELEGRAM_TOKEN
CONTACT_EMAIL=$CONTACT_EMAIL
# Signs the mini app's session cookies. Generate once with `openssl rand -hex 32`.
SESSION_SECRET=$SESSION_SECRET
