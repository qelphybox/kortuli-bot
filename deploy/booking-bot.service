[Unit]
Description=Padel slot watcher (Telegram bot + poller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=booking
WorkingDirectory=/srv/booking
EnvironmentFile=/srv/booking/.env
ExecStart=/usr/local/bin/bundle exec bin/bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# The process needs its own directory and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/booking/data

[Install]
WantedBy=multi-user.target
